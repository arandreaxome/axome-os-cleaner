{
  "manifest_version": 3,
  "name": "Axome OS allégé",
  "version": "0.1.0",
  "description": "Masque ce qui ne sert pas à un dev et préfiltre Axome OS sur ses projets, tâches et tickets.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Axome OS allégé",
    "default_popup": "pages/popup.html"
  },
  "options_page": "pages/options.html",
  "content_scripts": [
    {
      "matches": ["https://os.axome.com/*"],
      "js": ["dist/content.js"],
      "css": ["src/skin.css"],
      "run_at": "document_start"
    }
  ]
}
